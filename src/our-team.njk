---
layout: layouts/base.njk
permalink: /our-team/
title: About us and our team
eleventyComputed:
  seo_title: "{{ about.seo_title }}"
  seo_description: "{{ about.seo_description }}"
---
<section class="page-hd">
  <div class="wrap">
    <h1>{{ about.h1 }}</h1>
    <p class="lead">{{ about.intro }}</p>
  </div>
</section>
{%- from "partials/icons.njk" import icon -%}
<section class="sec">
  <div class="wrap story">
    <div class="prose">
      <h2>{{ about.story_heading }}</h2>
      <p>{{ about.story_text }}</p>
      <p>{{ about.child_safe }}</p>
    </div>
    <div class="story-photo">{% img about.photo, about.photo_alt, "(max-width: 960px) 92vw, 440px" %}</div>
  </div>
</section>
<section class="sec sec-warm">
  <div class="wrap story story-rev">
    <div class="story-video">
      <video controls playsinline preload="none" poster="{{ about.video_poster }}" aria-label="Everyday moments at Every Human" aria-describedby="about-vd">
        <source src="{{ about.video }}" type="video/mp4">
      </video>
      <p class="sr" id="about-vd">{{ about.video_description }}</p>
    </div>
    <div>
      <h2>{{ home.values_heading }}</h2>
      <ul class="values values-sm">
        {%- for v in home.values %}
        <li>{{ icon("check") }}<div><h3>{{ v.title }}</h3><p>{{ v.text }}</p></div></li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>
{%- set office = [] -%}{%- set support = [] -%}
{%- for t in collections.team -%}
  {%- if t.data.team == "Office team" %}{% set office = (office.push(t), office) %}{% else %}{% set support = (support.push(t), support) %}{% endif -%}
{%- endfor -%}
{%- if office.length %}
<section class="sec sec-soft">
  <div class="wrap">
    <div class="sec-hd"><h2>{{ about.office_heading }}</h2><p class="lead">{{ about.office_intro }}</p></div>
    {%- set people = office %}
    {% include "partials/team.njk" %}
  </div>
</section>
{%- endif %}
{%- if support.length %}
<section class="sec">
  <div class="wrap">
    <div class="sec-hd"><h2>{{ about.support_heading }}</h2><p class="lead">{{ about.support_intro }}</p></div>
    {%- set groups = support | teamGroups(collections.locations) %}
    {%- if groups.length > 1 %}
    <div class="team-filter" role="group" aria-label="Show support workers by location" data-team-filter>
      <button type="button" aria-pressed="true" data-filter="all">All <span>{{ support.length }}</span></button>
      {%- for g in groups %}
      <button type="button" aria-pressed="false" data-filter="{{ g.key | slug }}">{{ g.label }} <span>{{ g.count }}</span></button>
      {%- endfor %}
    </div>
    <p class="sr" aria-live="polite" data-filter-status></p>
    {%- endif %}
    {%- set people = support %}
    {% include "partials/team.njk" %}
  </div>
</section>
{%- endif %}
<section class="sec sec-warm">
  <div class="wrap join">
    <div><h2>Want to join us?</h2><p class="lead">We're always keen to meet kind, reliable people who love helping others live well.</p></div>
    <div class="btns"><a class="btn btn-go" href="/careers/">See careers</a></div>
  </div>
</section>
