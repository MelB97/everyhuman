<ul class="cards locs">
  {%- for l in collections.locations %}
  <li class="card card-photo loc-card">
    <div class="card-img">{% img l.data.image, "", "(max-width: 640px) 92vw, 380px" %}</div>
    <div class="card-body">
      <p class="loc-state">{{ l.data.region }}, {{ l.data.state }}</p>
      <h3><a class="card-link" href="{{ l.url }}">{{ l.data.title }}</a></h3>
      <p>{{ l.data.summary }}</p>
    </div>
  </li>
  {%- endfor %}
</ul>
