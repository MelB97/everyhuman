{#- Simple line icons. Usage: {% from "partials/icons.njk" import icon %} {{ icon("home") }} -#}
{%- macro icon(name, cls="ico") -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "personal" -%}
<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>
{%- elif name == "community" -%}
<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.4"/><path d="M15.6 14.1c3 .3 5.4 2.7 5.4 5.9"/>
{%- elif name == "skills" -%}
<path d="M12 21v-9"/><path d="M12 12c0-4 3-7 7-7 0 4-3 7-7 7z"/><path d="M12 14.5c0-3-2.5-5.5-6-5.5 0 3 2.5 5.5 6 5.5z"/>
{%- elif name == "home" -%}
<path d="M3 11l9-7 9 7"/><path d="M5 9.5V20h14V9.5"/><path d="M10 20v-5.5h4V20"/>
{%- elif name == "transport" -%}
<path d="M4 16.5v-4.2L6.2 7h11.6l2.2 5.3v4.2z"/><path d="M4 12.3h16"/><circle cx="7.8" cy="17.2" r="1.6"/><circle cx="16.2" cy="17.2" r="1.6"/>
{%- elif name == "transitions" -%}
<path d="M12 21V3"/><path d="M12 6h6.5l2 2-2 2H12"/><path d="M12 12H5.5l-2 2 2 2H12"/>
{%- elif name == "aged" -%}
<path d="M3 11l9-7 9 7"/><path d="M5 9.5V20h14V9.5"/><path d="M12 17.2s-3-1.8-3-4a1.6 1.6 0 0 1 3-.9 1.6 1.6 0 0 1 3 .9c0 2.2-3 4-3 4z"/>
{%- elif name == "phone" -%}
<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
{%- elif name == "mail" -%}
<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5l8.5 6 8.5-6"/>
{%- elif name == "pin" -%}
<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
{%- elif name == "check" -%}
<path d="M5 12.5l4.5 4.5L19 7.5"/>
{%- elif name == "arrow" -%}
<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>
{%- elif name == "info" -%}
<circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><path d="M12 7.5v.5"/>
{%- elif name == "lock" -%}
<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/>
{%- elif name == "chat" -%}
<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9.5h8"/><path d="M8 12.5h5"/>
{%- elif name == "shield" -%}
<path d="M12 3l8 3v6c0 4.6-3.4 8.2-8 9-4.6-.8-8-4.4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>
{%- elif name == "doc" -%}
<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6"/><path d="M9 15.5h6"/>
{%- elif name == "eye" -%}
<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>
{%- elif name == "share" -%}
<circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 10.8l7.6-3.6"/><path d="M8.2 13.2l7.6 3.6"/>
{%- elif name == "help" -%}
<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.6v.6"/><path d="M12 17v.4"/>
{%- elif name == "child" -%}
<circle cx="12" cy="6" r="2.6"/><path d="M8 21v-5.5L6 11.5l3-1.5h6l3 1.5-2 4V21"/><path d="M12 16v5"/>
{%- elif name == "alert" -%}
<path d="M12 3.5l9.5 16.5h-19z"/><path d="M12 10v4.5"/><path d="M12 17.4v.3"/>
{%- elif name == "computer" -%}
<rect x="3" y="4.5" width="18" height="12" rx="1.5"/><path d="M9 20.5h6"/><path d="M12 16.5v4"/>
{%- elif name == "smile" -%}
<circle cx="12" cy="12" r="9"/><path d="M8.5 14a4.2 4.2 0 0 0 7 0"/><path d="M9 9.5v.4"/><path d="M15 9.5v.4"/>
{%- elif name == "clock" -%}
<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>
{%- elif name == "law" -%}
<path d="M12 4v16"/><path d="M7 20h10"/><path d="M5 7h14"/><path d="M5 7l-2.5 6a2.5 2.5 0 0 0 5 0z"/><path d="M19 7l-2.5 6a2.5 2.5 0 0 0 5 0z"/>
{%- else -%}
<circle cx="12" cy="12" r="8"/>
{%- endif -%}
</svg>
{%- endmacro %}
