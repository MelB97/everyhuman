---
layout: layouts/base.njk
permalink: /
bodyClass: is-home
eleventyComputed:
  seo_title: "{{ home.seo_title }}"
  seo_description: "{{ home.seo_description }}"
---
{%- from "partials/icons.njk" import icon -%}
{%- set callable = site.phone | hasPhone -%}
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-txt">
      <p class="kicker">{{ home.kicker }}</p>
      <h1>{{ home.h1 }} <em>{{ home.h1_highlight }}</em></h1>
      <p class="lead">{{ home.intro }}</p>
      <div class="btns">
        <a class="btn btn-go" href="/contact-us/">Get started</a>
        <a class="btn btn-line" href="/referrals/">Make a referral</a>
      </div>
      <p class="hero-where">{{ icon("pin") }} {% for l in collections.locations %}<a href="{{ l.url }}">{{ l.data.title }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}{% if callable %}<span class="hero-call"> {{ icon("phone") }} <a href="{{ site.phone | telLink }}">{{ site.phone }}</a></span>{% endif %}</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 440 400" width="440" height="400">
        <circle cx="220" cy="210" r="178" fill="#f6e6d4"/>
        <circle cx="330" cy="92" r="26" fill="#f2b84b"/>
        <circle cx="86" cy="118" r="10" fill="#e9a9a0"/>
        <circle cx="372" cy="300" r="8" fill="#1f4d4a" opacity=".5"/>
        <!-- person left -->
        <path d="M70 360c0-62 30-112 78-112s78 50 78 112z" fill="#1f4d4a"/>
        <circle cx="148" cy="196" r="38" fill="#c98a63"/>
        <!-- person right -->
        <path d="M214 360c0-70 34-126 86-126s86 56 86 126z" fill="#e07a4f"/>
        <circle cx="300" cy="180" r="42" fill="#8a5a3c"/>
        <!-- person middle (in front) -->
        <path d="M140 372c0-56 34-100 80-100s80 44 80 100z" fill="#f2b84b"/>
        <circle cx="220" cy="228" r="34" fill="#e8b48f"/>
        <!-- linked arms -->
        <path d="M196 318c-18 4-36 2-52-8" stroke="#1f4d4a" stroke-width="16" stroke-linecap="round" fill="none"/>
        <path d="M244 318c18 4 36 2 52-8" stroke="#e07a4f" stroke-width="16" stroke-linecap="round" fill="none"/>
        <!-- heart -->
        <path d="M220 152s-17-10-17-23a9 9 0 0 1 17-5 9 9 0 0 1 17 5c0 13-17 23-17 23z" fill="#e07a4f"/>
      </svg>
    </div>
  </div>
</section>

<section class="paths">
  <div class="wrap">
    <ul class="path-list">
      {%- for p in home.paths %}
      <li class="path path-{{ loop.index }}">
        <h2 class="h-sm">{{ p.title }}</h2>
        <p>{{ p.text }}</p>
        <a class="text-link" href="{{ p.link }}">{{ p.button }} {{ icon("arrow") }}</a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.services_heading }}</h2>
      <p class="lead">{{ home.services_intro }}</p>
    </div>
    {% include "partials/service-cards.njk" %}
  </div>
</section>

<section class="sec sec-soft">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.steps_heading }}</h2>
    </div>
    <ol class="steps">
      {%- for s in home.steps %}
      <li><span class="step-n">{{ loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>
      {%- endfor %}
    </ol>
    <div class="btns btns-c">
      <a class="btn btn-go" href="/contact-us/">Start with step one</a>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.funding_heading }}</h2>
    </div>
    <ul class="cards funding">
      {%- for f in home.funding %}
      <li class="card"><h3>{{ f.title }}</h3><p>{{ f.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec sec-warm">
  <div class="wrap values-in">
    <div>
      <h2>{{ home.values_heading }}</h2>
    </div>
    <ul class="values">
      {%- for v in home.values %}
      <li>{{ icon("check") }}<div><h3>{{ v.title }}</h3><p>{{ v.text }}</p></div></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.locations_heading }}</h2>
      <p class="lead">{{ home.locations_intro }}</p>
    </div>
    <ul class="cards locs">
      {%- for l in collections.locations %}
      <li class="card loc-card">
        <p class="loc-state">{{ l.data.region }}, {{ l.data.state }}</p>
        <h3><a class="card-link" href="{{ l.url }}">{{ l.data.title }}</a></h3>
        <p>{{ l.data.summary }}</p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{%- if collections.team.length %}
<section class="sec sec-soft">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.team_heading }}</h2>
      <p class="lead">{{ home.team_intro }}</p>
    </div>
    {%- set people = collections.team | limit(8) %}
    {% include "partials/team.njk" %}
    <div class="btns btns-c"><a class="btn btn-line" href="/our-team/">Meet the whole team</a></div>
  </div>
</section>
{%- endif %}

{% include "partials/cta.njk" %}
