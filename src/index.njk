---
layout: layouts/base.njk
permalink: /
bodyClass: is-home
eleventyComputed:
  seo_title: "{{ home.seo_title }}"
  seo_description: "{{ home.seo_description }}"
---
{%- from "partials/icons.njk" import icon -%}
{%- set callable = site.phone | hasPhone -%}
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-txt">
      <p class="kicker">{{ home.kicker }}</p>
      <h1>{{ home.h1 }} <em>{{ home.h1_highlight }}</em></h1>
      <p class="lead">{{ home.intro }}</p>
      <div class="btns">
        <a class="btn btn-go" href="/contact-us/">Get started</a>
        <a class="btn btn-line" href="/referrals/">Make a referral</a>
      </div>
      <p class="hero-where">{{ icon("pin") }} {% for l in collections.locations %}<a href="{{ l.url }}">{{ l.data.short_title or l.data.title }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}{% if callable %}<span class="hero-call"> {{ icon("phone") }} <a href="{{ site.phone | telLink }}">{{ site.phone }}</a></span>{% endif %}</p>
    </div>
    <div class="hero-art">
      <ul class="hex-cluster">
        {%- for h in home.hero_photos | limit(5) %}
        <li class="hex hex-{{ loop.index }}">{% img h.image, h.alt, ("(max-width: 960px) 60vw, 360px" if loop.first else "(max-width: 960px) 30vw, 180px"), "", loop.first %}</li>
        {%- endfor %}
      </ul>
      {%- if site.ndis_registered %}<span class="hero-badge">{% logo site.ndis_badge, "Registered NDIS provider", "" %}</span>{% endif %}
    </div>
  </div>
</section>

<section class="paths">
  <div class="wrap">
    <ul class="path-list">
      {%- for p in home.paths %}
      <li class="path path-{{ loop.index }}">
        <h2 class="h-sm">{{ p.title }}</h2>
        <p>{{ p.text }}</p>
        <a class="text-link" href="{{ p.link }}">{{ p.button }} {{ icon("arrow") }}</a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.services_heading }}</h2>
      <p class="lead">{{ home.services_intro }}</p>
    </div>
    {% include "partials/service-cards.njk" %}
  </div>
</section>

{%- if home.stories.length %}
<section class="sec sec-warm">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.stories_heading }}</h2>
      <p class="lead">{{ home.stories_intro }}</p>
    </div>
    {%- set stories = home.stories %}
    {% include "partials/stories.njk" %}
  </div>
</section>
{%- endif %}

<section class="sec sec-soft">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.steps_heading }}</h2>
    </div>
    <ol class="steps">
      {%- for s in home.steps %}
      <li><span class="step-n">{{ loop.index }}</span><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>
      {%- endfor %}
    </ol>
    <div class="btns btns-c">
      <a class="btn btn-go" href="/contact-us/">Start with step one</a>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.funding_heading }}</h2>
    </div>
    <ul class="cards funding">
      {%- for f in home.funding %}
      <li class="card"><h3>{{ f.title }}</h3><p>{{ f.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec sec-soft">
  <div class="wrap values-in">
    <div>
      <h2>{{ home.values_heading }}</h2>
    </div>
    <ul class="values">
      {%- for v in home.values %}
      <li>{{ icon("check") }}<div><h3>{{ v.title }}</h3><p>{{ v.text }}</p></div></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.locations_heading }}</h2>
      <p class="lead">{{ home.locations_intro }}</p>
    </div>
    {% include "partials/location-cards.njk" %}
  </div>
</section>

{%- if home.moments.length %}
<section class="sec sec-soft moments-sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.moments_heading }}</h2>
      <p class="lead">{{ home.moments_intro }}</p>
    </div>
  </div>
  <div class="moments-scroll" tabindex="0" role="region" aria-label="{{ home.moments_heading }} photos, scroll sideways for more">
  <ul class="moments">
    {%- for m in home.moments %}
    <li>{% img m.image, m.alt, "(max-width: 640px) 60vw, 300px" %}</li>
    {%- endfor %}
  </ul>
  </div>
</section>
{%- endif %}

{%- if collections.team.length %}
<section class="sec">
  <div class="wrap">
    <div class="sec-hd">
      <h2>{{ home.team_heading }}</h2>
      <p class="lead">{{ home.team_intro }}</p>
    </div>
    {%- set people = collections.team | limit(8) %}
    {% include "partials/team.njk" %}
    <div class="btns btns-c"><a class="btn btn-line" href="/our-team/">Meet the whole team</a></div>
  </div>
</section>
{%- endif %}

{% include "partials/cta.njk" %}
